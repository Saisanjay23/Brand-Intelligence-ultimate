# Optional. Copy this file to `.env` in the PROJECT ROOT (next to run.py).
# With no .env at all, every value below is simply its default, so the tool
# behaves the same on any laptop. Every uncommented value here EQUALS the code
# default (tests/test_fresh_clone_contract.py checks that), so copying this file
# changes nothing until you edit a line. Lines starting with `#` are the knobs
# you may want; remove the `#` to use one.

# Deployment tier: development | staging | production
# .env is only loaded automatically in development -- staging/production
# must receive these as real process environment variables.
ENV=development

# --- server ---
HOST=127.0.0.1
PORT=8000

# --- storage -- one shared database, not one per platform ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=brand_intelligence

# --- alerts (optional) ---
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ALERT_EMAILS=
ALERT_FROM=alerts@brand-intelligence.local

# --- pacing ---
REQUEST_TIMEOUT_SEC=45
ANALYSIS_DELAY_SEC=2.5
# Ceiling (seconds) for waiting on a profile's data; raise on a slow laptop/connection
ANALYSIS_SETTLE_SEC=15
# Seconds an Instagram account rests after real use before analysis starts on it
INSTAGRAM_REST_BEFORE_ANALYSIS_SEC=45
# Hourly ceilings per Instagram account (Threads on the same account counts
# too). Work over the ceiling waits, it is never skipped. 0 = no ceiling.
# Searches are uncapped by default (0); set a number to cap them again.
INSTAGRAM_SEARCHES_PER_HOUR=0
INSTAGRAM_PROFILE_VISITS_PER_HOUR=20
# Daily ceilings per Instagram account (UTC day, kept across restarts). At the
# ceiling the account rests until 00:00 UTC and the rest is left owed. 0 = none.
INSTAGRAM_SEARCHES_PER_DAY=0
INSTAGRAM_PROFILE_VISITS_PER_DAY=150
# A newly added account starts at 25% of the daily ceilings and reaches 100%
# after this many days. 0 = no warm-up.
INSTAGRAM_WARMUP_DAYS=14
# Instagram/Threads login checks (the account opening its own settings page):
# skipped within this many hours of the account last working, and done at most
# this often for an idle account.
META_PROVEN_FRESH_HOURS=6.0
META_IDLE_RECHECK_HOURS=24.0
# Hold an Instagram/Threads account when this machine is in a different COUNTRY
# than where the account last worked (a VPN flip looks like a hijack). It resumes
# by itself when the network goes back; re-pasting cookies accepts the new place.
META_EGRESS_GUARD=true
META_EGRESS_HOLD_MINUTES=20.0
# Instagram and Threads on one account never run at once: how long a job
# waits for the other site to finish, and how long a challenge on one site
# rests the same account on the other.
META_LINKED_WAIT_MINUTES=120
META_LINKED_CHECKPOINT_REST_HOURS=24
DISCOVERY_CONCURRENCY=2
DISCOVERY_MAX_SECONDS=900
HEADLESS=true

# --- scheduler pacing (see README "Scheduler pacing") ---
# Rest between one client and the next, seconds; actual rest is 0.7x to 1.6x this.
# SCHEDULER_CLIENT_GAP_SECONDS=180
# A scheduled run starts up to this many minutes late, at random. 0 disables it.
# SCHEDULER_START_JITTER_MINUTES=15

# --- smaller laptops (see README "Running on a smaller laptop") ---
# Worker limits size themselves to the machine when these are NOT set; setting
# one overrides that with exactly your number.
# ANALYSIS_MAX_BROWSER_WORKERS=4
# DISCOVERY_MAX_BROWSER_WORKERS=4
# DISCOVERY_MAX_PARALLEL_SESSIONS=3
# A browser start waits (up to the seconds below) for this much free memory,
# then goes ahead anyway. 0 on either turns the wait off.
# BROWSER_MIN_FREE_MB=1800
# BROWSER_START_WAIT_SECONDS=45
# CLIP logo-embedding tier: off by default (needs torch + a ~600 MB model).
# LOGO_EMBEDDINGS_ENABLED=false

# --- where things live ---
# Keep the session folder (live Chrome profiles + cookies) OUT of OneDrive,
# Dropbox, iCloud and Google Drive: `python run.py --check` warns if it is in one.
# SESSION_BLOB_PATH=session
# To use a specific Chrome/Chromium instead of the one found on this machine,
# set CHROME_BINARY as a REAL environment variable (this file is not read for
# it), e.g. in PowerShell:  $env:CHROME_BINARY = "D:\Chrome\chrome.exe"

# --- Instagram discovery without an Instagram account (optional, paid) ---
# "account" (default) searches with a pooled, logged-in Instagram account.
# "hikerapi" sends each keyword search to the HikerAPI vendor instead: no
# Instagram account is used, no browser starts. Needs HIKERAPI_KEY below;
# with no key it behaves exactly like "account". Billed per request by HikerAPI.
# Discovery only -- Instagram analysis has its own no-login path, below.
INSTAGRAM_SEARCH_PROVIDER=account
# Your HikerAPI access key (hikerapi.com/tokens). Never commit a real one.
HIKERAPI_KEY=

# --- Instagram analysis without an Instagram account ---
# true (default): each Instagram profile is first read from its PUBLIC page in a
# browser with no login, so no account is used. Only when Instagram refuses a
# logged-out visitor does the batch fall back to the pooled accounts. Analysis
# only -- keyword search (discovery) still needs an account or the vendor above.
INSTAGRAM_ANALYSIS_NO_LOGIN=true
# No-login profile visits allowed per hour from this machine (its IP address).
# Over the ceiling the visits wait. Never counted against any account.
INSTAGRAM_NO_LOGIN_PROFILES_PER_HOUR=60

# --- platform credentials (key-authed / MTProto platforms) ---
YOUTUBE_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
