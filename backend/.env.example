# Deployment tier: development | staging | production
# .env is only loaded automatically in development -- staging/production
# must receive these as real process environment variables.
ENV=development

# --- server ---
HOST=127.0.0.1
PORT=8000

# --- storage -- one shared database, not one per platform (see docs/adr/0006) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=brand_intelligence

# --- alerts (optional) ---
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ALERT_EMAILS=
ALERT_FROM=alerts@brand-intelligence.local

# --- pacing ---
REQUEST_TIMEOUT_SEC=45
ANALYSIS_DELAY_SEC=6.0
ANALYSIS_CONCURRENCY=1
DISCOVERY_CONCURRENCY=2
DISCOVERY_MAX_SECONDS=300
HEADLESS=true

# --- webhooks ---
WEBHOOK_TIMEOUT_SEC=10.0
WEBHOOK_MAX_RETRIES=3

# --- platform credentials (key-authed / MTProto platforms) ---
YOUTUBE_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
