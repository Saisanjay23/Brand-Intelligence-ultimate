# Optional. Copy this file to `.env` in the PROJECT ROOT (next to run.py).
# With no .env at all, every value below is simply its default, so the tool
# behaves the same on any laptop. Every uncommented value here EQUALS the code
# default (tests/test_fresh_clone_contract.py checks that), so copying this file
# changes nothing until you edit a line. Lines starting with `#` are the knobs
# you may want; remove the `#` to use one.

# Deployment tier: development | staging | production
# .env is only loaded automatically in development -- staging/production
# must receive these as real process environment variables.
ENV=development

# --- server ---
HOST=127.0.0.1
PORT=8000

# --- storage -- one shared database, not one per platform ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=brand_intelligence

# --- alerts (optional) ---
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
ALERT_EMAILS=
ALERT_FROM=alerts@brand-intelligence.local

# --- pacing ---
REQUEST_TIMEOUT_SEC=45
ANALYSIS_DELAY_SEC=2.5
# Ceiling (seconds) for waiting on a profile's data; raise on a slow laptop/connection
ANALYSIS_SETTLE_SEC=15
# Instagram "About this account" panel: profiles per analysis batch it may be
# opened on (the only source of join date). 0 = never; rows say it was skipped
INSTAGRAM_ABOUT_PANEL_PER_BATCH=0
# Seconds an Instagram account rests after real use before analysis starts on it
INSTAGRAM_REST_BEFORE_ANALYSIS_SEC=45
DISCOVERY_CONCURRENCY=2
DISCOVERY_MAX_SECONDS=900
HEADLESS=true

# --- scheduler pacing (see README "Scheduler pacing") ---
# Rest between one client and the next, seconds; actual rest is 0.7x to 1.6x this.
# SCHEDULER_CLIENT_GAP_SECONDS=180
# A scheduled run starts up to this many minutes late, at random. 0 disables it.
# SCHEDULER_START_JITTER_MINUTES=15

# --- smaller laptops (see README "Running on a smaller laptop") ---
# Worker limits size themselves to the machine when these are NOT set; setting
# one overrides that with exactly your number.
# ANALYSIS_MAX_BROWSER_WORKERS=4
# DISCOVERY_MAX_BROWSER_WORKERS=4
# DISCOVERY_MAX_PARALLEL_SESSIONS=3
# A browser start waits (up to the seconds below) for this much free memory,
# then goes ahead anyway. 0 on either turns the wait off.
# BROWSER_MIN_FREE_MB=1800
# BROWSER_START_WAIT_SECONDS=45
# CLIP logo-embedding tier: off by default (needs torch + a ~600 MB model).
# LOGO_EMBEDDINGS_ENABLED=false

# --- where things live ---
# Keep the session folder (live Chrome profiles + cookies) OUT of OneDrive,
# Dropbox, iCloud and Google Drive: `python run.py --check` warns if it is in one.
# SESSION_BLOB_PATH=session
# To use a specific Chrome/Chromium instead of the one found on this machine,
# set CHROME_BINARY as a REAL environment variable (this file is not read for
# it), e.g. in PowerShell:  $env:CHROME_BINARY = "D:\Chrome\chrome.exe"

# --- platform credentials (key-authed / MTProto platforms) ---
YOUTUBE_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
